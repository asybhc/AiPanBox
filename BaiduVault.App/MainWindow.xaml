<Window x:Class="BaiduVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiPanBox" Width="960" Height="600"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,18,0">
                    <TextBlock Text="AiPanBox" FontSize="16" FontWeight="SemiBold" Foreground="#FF0B63C5"/>
                    <TextBlock Text="v1.0 · 一杯好茶" FontSize="10" Foreground="#FF666666" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="刷新" Click="Refresh_Click" Padding="16,5" Margin="0,0,10,0"/>
                    <Button Content="库管理" Click="Libraries_Click" Padding="16,5" Margin="0,0,10,0"/>
                    <Button Content="账号管理" Click="Accounts_Click" Padding="16,5" Margin="0,0,10,0"/>
                    <Button Content="上传" Click="Upload_Click" Padding="16,5" Margin="0,0,10,0"/>
                    <Button Content="设置" Click="Settings_Click" Padding="16,5" Margin="0,0,10,0"/>
                    <Button Content="使用说明" Click="Help_Click" Padding="16,5"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF0B63C5"
                           HorizontalAlignment="Right" Text="正在连接本地实例…"/>
            </DockPanel>
        </Border>
        <TreeView x:Name="VaultTree" Background="#FFFFFFFF" Foreground="#FF1A1A1A"
                  BorderThickness="0" Padding="12,10"
                  MouseDoubleClick="VaultTree_MouseDoubleClick"
                  TreeViewItem.Expanded="Item_Expanded"/>
    </DockPanel>
</Window>
