<Window x:Class="BaiduVault.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用说明" Width="880" Height="680"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock Text="使用说明" FontSize="15" FontWeight="SemiBold" Foreground="#FF0B63C5" VerticalAlignment="Center"/>
                <Button Content="关闭" Click="Close_Click" Padding="18,5" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel x:Name="DocPanel" Margin="22,14,18,24"/>
        </ScrollViewer>
    </DockPanel>
</Window>
