<Window x:Class="BaiduVault.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号管理" Width="1060" Height="580"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="刷新" Click="Refresh_Click" Padding="14,5" Margin="0,0,8,0"/>
                    <Button Content="编辑凭证" Click="Edit_Click" Padding="14,5" Margin="0,0,8,0"/>
                    <Button Content="移出挂载" Click="Unmount_Click" Padding="14,5" Margin="0,0,8,0"/>
                    <Button Content="删除账号" Click="Delete_Click" Padding="14,5" Margin="0,0,8,0"/>
                    <Button Content="重启服务" Click="Restart_Click" Padding="14,5"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#FF666666" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,2,0"/>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" x:Name="HintText" TextWrapping="Wrap"
                   Foreground="#FF666666" FontSize="12" Margin="4,0,4,8"/>
        <DataGrid x:Name="AccountGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30"
                  CanUserResizeRows="False" HorizontalScrollBarVisibility="Disabled"
                  Background="#FFF2F2F5" RowBackground="#FFF2F2F5" AlternatingRowBackground="#FFF2F2F5"
                  BorderBrush="#FFDDDDDF" BorderThickness="1"
                  MouseDoubleClick="AccountGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="账号" Binding="{Binding Name}" Width="110"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="120"/>
                <DataGridTextColumn Header="驱动" Binding="{Binding Driver}" Width="130"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="76"/>
                <DataGridTextColumn Header="已配置字段" Binding="{Binding Credentials}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Credentials}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="密钥" Binding="{Binding KeyText}" Width="52"/>
                <DataGridTextColumn Header="挂载" Binding="{Binding MountText}" Width="52"/>
                <DataGridTextColumn Header="提示" Binding="{Binding Detail}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Detail}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
