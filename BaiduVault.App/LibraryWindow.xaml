<Window x:Class="BaiduVault.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库管理" Width="1000" Height="520"
        Background="#FF1B1B1F" Foreground="#FFE6E6E6"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加" Click="Add_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="编辑/重登" Click="Edit_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="重命名" Click="Rename_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="移出挂载" Click="Unmount_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="彻底删除" Click="Delete_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="刷新" Click="Refresh_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="重启服务" Click="RestartService_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="导出密钥备份包" Click="Export_Click" Padding="12,4" Margin="0,0,16,0"/>
                <CheckBox x:Name="AutoCheck" Content="自动检测（60 秒）" IsChecked="True"
                          VerticalAlignment="Center" Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"
                          Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF9CDCFE" Text=""/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Background="#FF26262C" Foreground="#FFE6E6E6"
                  BorderBrush="#FF3F3F46" RowBackground="#FF26262C" AlternatingRowBackground="#FF2E2E35"
                  HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF3F3F46"/>
                    <Setter Property="Foreground" Value="#FFE6E6E6"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#FFE6E6E6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="6,2">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF3A3A42"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="库名" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="驱动" Binding="{Binding Driver}" Width="140"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                <DataGridTextColumn Header="挂载路径" Binding="{Binding MountPath}" Width="90"/>
                <DataGridTextColumn Header="密钥" Binding="{Binding KeyText}" Width="50"/>
                <DataGridTextColumn Header="详情" Binding="{Binding StatusDetail}" Width="220"/>
                <DataGridTextColumn Header="处理建议" Binding="{Binding Advice}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
