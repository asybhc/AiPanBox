<Window x:Class="BaiduVault.App.UploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上传到加密库" Width="1240" Height="640"
        Background="#FF1B1B1F" Foreground="#FFE6E6E6"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="12,12,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 源文件 -->
        <Border Grid.Row="0" Background="#FF26262C" BorderBrush="#FF34343A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="源文件/文件夹（可拖拽到窗口，或点击选择）" FontWeight="Bold" Foreground="#FF9CDCFE" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="选择文件…" Click="PickFiles_Click" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="选择文件夹…" Click="PickFolder_Click" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="清空" Click="ClearSources_Click" Padding="12,4"/>
                    <TextBlock x:Name="EstimateText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF888888"/>
                </StackPanel>
                <ListBox x:Name="SourceList" Height="48" Margin="0,8,0,0"
                         Background="#FF1B1B1F" Foreground="#FFE6E6E6" BorderBrush="#FF3F3F46">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#FFE6E6E6"/>
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FFE6E6E6" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 目标 -->
        <Border Grid.Row="1" Background="#FF26262C" BorderBrush="#FF34343A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="目标" FontWeight="Bold" Foreground="#FF9CDCFE" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标库" VerticalAlignment="Center" Grid.Column="0"/>
                    <ComboBox x:Name="TargetLibBox" Grid.Column="1" MinWidth="360" HorizontalAlignment="Stretch"
                              SelectionChanged="TargetLibBox_SelectionChanged"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="远端目录" VerticalAlignment="Center" Grid.Column="0"/>
                    <TextBox x:Name="TargetPrefixBox" Grid.Column="1" Text="/"
                             Background="#FF1B1B1F" Foreground="#FFE6E6E6"/>
                    <Button x:Name="BrowseBtn" Content="浏览远端目录…" Click="Browse_Click"
                            Grid.Column="2" Padding="12,4" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 选项 -->
        <Border Grid.Row="2" Background="#FF26262C" BorderBrush="#FF34343A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="并发数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ConcurrencyBox" Width="50" Background="#FF1B1B1F" Foreground="#FFE6E6E6"/>
                <CheckBox x:Name="SkipExistingBox" Content="跳过已存在（文件级续传）" IsChecked="True"
                          ToolTip="跳过已存在的文件：中断后重跑只补传缺失的文件；单个文件若中途中断会从头重传（不支持按字节续传）。"
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock Text="失败重试" VerticalAlignment="Center" Margin="20,0,6,0"/>
                <TextBox x:Name="RetriesBox" Width="40" Background="#FF1B1B1F" Foreground="#FFE6E6E6" Text="3"/>
                <CheckBox x:Name="VerifyBox" Content="完成后校验（大小/哈希）" IsChecked="True"
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="QueueText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#FF9CDCFE"/>
            </StackPanel>
        </Border>

        <!-- 队列 -->
        <Border Grid.Row="3" Background="#FF26262C" BorderBrush="#FF34343A" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#FF26262C" Foreground="#FFE6E6E6" BorderBrush="#FF3F3F46"
                      RowBackground="#FF26262C" AlternatingRowBackground="#FF2E2E35"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF3F3F46"/>
                        <Setter Property="Foreground" Value="#FFE6E6E6"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#FFE6E6E6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="6,2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF3A3A42"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="2.2*"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="0.7*"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Dest}" Width="3*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="0.8*"/>
                    <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="0.7*"/>
                    <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="1*"/>
                    <DataGridTextColumn Header="校验" Binding="{Binding Verify}" Width="1.4*"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Result}" Width="1.6*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 日志 -->
        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"
                 Background="#FF1B1B1F" Foreground="#FFB0B0B0" BorderBrush="#FF3F3F46"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartBtn" Content="开始上传" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,5" Margin="0,0,8,0"/>
            <Button x:Name="PauseBtn" Content="暂停" Click="Pause_Click" Padding="14,5" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="ResumeBtn" Content="继续" Click="Resume_Click" Padding="14,5" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="CancelTaskBtn" Content="取消当前" Click="CancelTask_Click" Padding="14,5" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="CancelAllBtn" Content="取消全部" Click="CancelAll_Click" Padding="14,5" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="RetryBtn" Content="重试失败" Click="Retry_Click" Padding="14,5" Margin="0,0,8,0"/>
            <Button Content="关闭" Click="Close_Click" Padding="18,5"/>
        </StackPanel>
    </Grid>
</Window>
