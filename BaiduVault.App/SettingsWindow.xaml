<Window x:Class="BaiduVault.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="760" Height="580"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel>

                <!-- 服务端口 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="服务端口（修改后需重启对应服务）" FontWeight="Bold" Foreground="#FF0B63C5" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="网盘服务端口" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="OpenListPortBox" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Background="#FFFFFFFF" Foreground="#FF1A1A1A"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放服务端口" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="WebDavPortBox" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Background="#FFFFFFFF" Foreground="#FF1A1A1A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 缓存 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="缓存" FontWeight="Bold" Foreground="#FF0B63C5" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="缓存上限" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="CacheMaxSizeBox" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Background="#FFFFFFFF" Foreground="#FF1A1A1A"/>
                        </Grid>
                        <CheckBox x:Name="ClearCacheOnExitBox" Content="退出时清理播放明文缓存" Margin="0,8,0,2"/>
                        <TextBlock Text="⚠ 播放缓存里保存的是解密后的明文（已实测：缓存文件与原文件内容完全一致）。开启后退出应用会自动清空，下次播放需重新下载解密。"
                                   Foreground="#FF9A5B00" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 播放 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="播放" FontWeight="Bold" Foreground="#FF0B63C5" Margin="0,0,0,8"/>
                        <CheckBox x:Name="HardwareDecodingBox" Content="硬件解码（开启 = 自动选择，关闭 = 强制软解）" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字幕编码" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="SubtitleEncodingBox" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                     Background="#FFFFFFFF" Foreground="#FF1A1A1A"/>
                        </Grid>
                        <TextBlock Text="默认使用 GB18030 编码，可兼容 GBK 编码的外挂字幕；若字幕出现乱码，可依次尝试 UTF-8、GBK、BIG5。"
                                   Foreground="#FF666666" FontSize="11" Margin="0,2,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认播放行为" VerticalAlignment="Center" Grid.Column="0"/>
                            <ComboBox x:Name="DefaultPlayBehaviorBox" Grid.Column="1" Width="140" HorizontalAlignment="Left">
                                <ComboBoxItem Content="从上次位置续播" Tag="resume"/>
                                <ComboBoxItem Content="从头播放" Tag="start"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="系统" FontWeight="Bold" Foreground="#FF0B63C5" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AutoStartBox" Content="开机自启（写入当前用户启动项，无需管理员）" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上传并发数" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="UploadConcurrencyBox" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Background="#FFFFFFFF" Foreground="#FF1A1A1A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 密钥备份 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="密钥备份" FontWeight="Bold" Foreground="#FF0B63C5" Margin="0,0,0,8"/>
                        <TextBlock Text="备份包包含同步配置和全部库的加密密钥。丢失密钥 = 加密文件永远无法解密。请妥善保管备份包。"
                                   Foreground="#FF9A5B00" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导出备份包…" Click="ExportBackup_Click" Padding="12,4" Margin="0,0,8,0"/>
                            <Button Content="导入备份包…" Click="ImportBackup_Click" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Background="#FFF6F6F8" BorderBrush="#FFDDDDDF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="日志" FontWeight="Bold" Foreground="#FF0B63C5" VerticalAlignment="Center"/>
                            <Button Content="刷新" Click="RefreshLogs_Click" Padding="8,2" Margin="10,0,8,0"/>
                            <Button Content="清空日志" Click="ClearLogs_Click" Padding="8,2" Margin="0,0,8,0"/>
                            <Button Content="打开日志目录" Click="OpenLogDir_Click" Padding="8,2"/>
                        </StackPanel>
                        <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#FFFFFFFF" Foreground="#FF666666"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,10,0,0">
            <Button Content="保存" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,5" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>
