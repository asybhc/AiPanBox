<Window x:Class="BaiduVault.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="AiPanBox 播放器" Width="1024" Height="640"
        Background="Black" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <lvs:VideoView x:Name="VideoView" Grid.Row="0"/>

        <Border Grid.Row="1" Background="#F0141418" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseBtn" Grid.Column="0" Content="暂停" Width="56"
                        Click="PlayPause_Click" Padding="0,4"/>
                <TextBlock x:Name="TimeText" Grid.Column="1" Foreground="#FFE6E6E6"
                           VerticalAlignment="Center" Margin="12,0" Text="--:-- / --:--"/>
                <Slider x:Name="SeekBar" Grid.Column="2" VerticalAlignment="Center"
                        Minimum="0" Maximum="1000" IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="SeekBar_Down"
                        PreviewMouseLeftButtonUp="SeekBar_Up"/>
                <ComboBox x:Name="SpuBox" Grid.Column="3" Width="140" Margin="12,0,0,0"
                          SelectionChanged="SpuBox_Changed" ToolTip="内嵌字幕轨"/>
                <Button Content="外挂字幕…" Grid.Column="4" Margin="8,0,0,0"
                        Click="LoadSub_Click" Padding="10,4"/>
                <Button Content="关闭" Grid.Column="5" Margin="8,0,0,0"
                        Click="Close_Click" Padding="10,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
